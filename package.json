
{
  "name": "my-todo-app",
  "version": "1.0.0",
  "description": "My first Electron To-Do List",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.mytodo.app",
    "productName": "My Todo App",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
